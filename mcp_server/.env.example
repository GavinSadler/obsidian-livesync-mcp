# Copy to .env and fill in values. See README.md for details.

# --- CouchDB (required) ---
# Base URL of your CouchDB server, including scheme + port.
COUCHDB_URL=https://your-couchdb-host:6984
# Name of the database holding the LiveSync vault.
COUCHDB_DATABASE=obsidian_vault
# Basic-auth credentials.
COUCHDB_USERNAME=admin
COUCHDB_PASSWORD=changeme
# Set to false to skip TLS verification (e.g., self-signed certs in dev).
COUCHDB_VERIFY_TLS=true

# --- LiveSync vault settings ---
# IMPORTANT: the MVP does NOT support encryption. You MUST have
# "End-to-End Encryption" disabled in the LiveSync plugin settings.
# Leave LIVESYNC_PASSPHRASE unset.
# LIVESYNC_PASSPHRASE=

# Set to true if your vault uses path obfuscation (`Path Obscuring`
# enabled in plugin settings). Requires LIVESYNC_PASSPHRASE.
LIVESYNC_OBFUSCATE_PATHS=false

# --- Vector search (NOT YET WIRED UP in the MVP) ---
# semantic_search returns empty results until these are implemented.
# VECTOR_ENABLED=true
# VECTOR_STORE=sqlite-vec
# VECTOR_STORE_PATH=./vector.db
# VECTOR_EMBEDDING_BACKEND=openai
# VECTOR_EMBEDDING_MODEL=text-embedding-3-small
# VECTOR_EMBEDDING_DIMENSION=1536
